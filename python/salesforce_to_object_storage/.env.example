# These SF_* names are defined by this sample, not by Salesforce.
# Choose exactly ONE authentication method and replace every placeholder.

# Method 1 (recommended): OAuth Client Credentials.
SF_AUTH_MODE='client-credentials'
SF_CLIENT_ID='replace-with-external-client-app-consumer-key'
SF_CLIENT_SECRET='replace-with-consumer-secret'
SF_DOMAIN='acme.my'

# Production alternative: put the plain client secret in OCI Vault, comment
# SF_CLIENT_SECRET above, and uncomment these variables.
# SF_CLIENT_SECRET_OCID='ocid1.vaultsecret.oc1...'
# SF_VAULT_OCI_AUTH='resource-principal'
# Optional for config-file auth:
# SF_VAULT_OCI_CONFIG_FILE='~/.oci/config'
# SF_VAULT_OCI_PROFILE='DEFAULT'

# Method 2: an existing OAuth token managed by another component.
# Comment Method 1 before uncommenting this block.
# SF_AUTH_MODE='access-token'
# SF_ACCESS_TOKEN='replace-with-oauth-access-token'
# SF_INSTANCE_URL='https://acme.my.salesforce.com'

# Method 3 (legacy connectivity test): username, password, and security token.
# Comment Method 1 before uncommenting this block. SF_PASSWORD is the password
# only; do not append the security token because simple-salesforce does that.
# SF_AUTH_MODE='password'
# SF_USERNAME='integration-user@example.com'
# SF_PASSWORD='replace-with-password'
# SF_SECURITY_TOKEN='replace-with-security-token'
# SF_DOMAIN='login'

# Domain examples:
#   production login URL: SF_DOMAIN='login'
#   sandbox login URL:    SF_DOMAIN='test'
#   https://acme.my.salesforce.com: SF_DOMAIN='acme.my'
#   https://acme--uat.sandbox.my.salesforce.com:
#       SF_DOMAIN='acme--uat.sandbox.my'

# Optional API version, without a leading "v".
# - OAuth: use a REST API version supported by the Salesforce organization.
# - Password: leave unset (the pinned library defaults to 59.0) or use an
#   organization-supported version no higher than 64.0.
# SF_API_VERSION='64.0'
