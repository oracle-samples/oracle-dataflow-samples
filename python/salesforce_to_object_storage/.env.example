# Choose ONE Salesforce authentication method.

# Method 1: username, password, and security token.
SF_USERNAME='integration-user@example.com'
SF_PASSWORD='replace-me'
SF_SECURITY_TOKEN='replace-me'

# Use "test" for a Salesforce sandbox. For a My Domain such as
# https://acme.my.salesforce.com, use "acme.my". The production default is login.
SF_DOMAIN='login'

# Method 2: an OAuth access token. If you use this method, remove or comment the
# username/password variables above.
# SF_ACCESS_TOKEN='replace-me'
# SF_INSTANCE_URL='https://acme.my.salesforce.com'

# Optional: pin a Salesforce REST API version supported by your organization.
# SF_API_VERSION='68.0'
